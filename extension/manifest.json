{
  "manifest_version": 3,
  "name": "herdr-web-browser",
  "version": "0.1.0",
  "description": "Send pages, selections, links and screenshots to a herdr agent, and record console output and requests for it.",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "scripting", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["recorder.js"], "run_at": "document_start", "world": "MAIN" }],
  "action": { "default_title": "Send page to herdr agent" }
}
